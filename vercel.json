{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/publish-bachelor.mjs",
  "outputDirectory": "dist-bachelor",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/version.txt",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/build-info.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
